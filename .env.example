# Local development uses a plain SQLite file.
DATABASE_URL="file:./dev.db"

# Production (Vercel) uses Turso, which is SQLite over HTTP so the schema is unchanged.
# Leave these unset locally and the app falls back to the file above.
# TURSO_DATABASE_URL="libsql://your-db.turso.io"
# TURSO_AUTH_TOKEN="..."
